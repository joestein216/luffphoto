# Copy this file to .env.local and fill in the values

# Server-only Dropbox API token (do NOT commit a real token)
DROPBOX_TOKEN=YOUR_DROPBOX_API_TOKEN

# Optional: shared link for a Dropbox folder (placeholder only — do not include real keys here)
DROPBOX_SHARED_LINK=https://www.dropbox.com/s/your-shared-link

# Optional: root path inside the shared link or account (e.g. /portfolio)
DROPBOX_ROOT_PATH=
